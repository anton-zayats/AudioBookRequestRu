# AudioBookRequestRu — environment variables.
#
# Copy to `.env` (for your deployment stack) and/or `.env.local` (used by the app
# during local development). Application settings are read with the `ABR_`
# prefix; nested settings are flattened with `__`, so `ABR_APP__CONFIG_DIR`
# sets `app.config_dir`.
#
# NOT configured via environment variables (edit them in the Settings UI; they
# are stored in ABR's config database instead):
#   - Prowlarr            Settings > Prowlarr
#   - Download client     Settings > Download   (aria2 host/port/RPC secret/dir)
#   - Direct sources      Settings > Direct sources (knigavuhe enabled/base URL/max candidates)
#   - Audiobookshelf      Settings > Audiobookshelf

# --- Config directory ---
# Where the SQLite database and runtime config live. Default: /config
ABR_APP__CONFIG_DIR=/config

# --- Application ---
ABR_APP__DEBUG=false              # Default: false
ABR_APP__OPENAPI_ENABLED=false    # Default: false. Exposes OpenAPI docs at /docs
ABR_APP__LOG_LEVEL=INFO           # Default: INFO (DEBUG, INFO, WARNING, ERROR)
ABR_APP__BASE_URL=                # Sub-path when served behind a reverse proxy (e.g. /abr)
ABR_APP__PORT=8000                # Default: 8000
ABR_APP__FORWARDED_ALLOW_IPS=127.0.0.1   # Trusted proxy IPs for forwarded headers
ABR_APP__FORCE_LOGIN_TYPE=        # Optional: basic | forms | oidc | none. Empty = user chooses
ABR_APP__INIT_ROOT_USERNAME=      # Optional: root username on a fresh database
ABR_APP__INIT_ROOT_PASSWORD=      # Optional: root password on a fresh database
ABR_APP__DISABLE_CENSOR=false     # Default: false

# --- Database ---
# SQLite is the default. The path is relative to ABR_APP__CONFIG_DIR unless absolute.
ABR_DB__SQLITE_PATH=db.sqlite
# To use Postgres instead, enable it and point at your server:
# ABR_DB__USE_POSTGRES=true
# ABR_DB__POSTGRES_HOST=localhost
# ABR_DB__POSTGRES_PORT=5432
# ABR_DB__POSTGRES_DB=audiobookrequest
# ABR_DB__POSTGRES_USER=abr
# ABR_DB__POSTGRES_PASSWORD=password
# ABR_DB__POSTGRES_SSL_MODE=prefer

# Services (Prowlarr, aria2 download client, Audiobookshelf, direct sources) are
# configured in the Settings UI, not via environment variables.
