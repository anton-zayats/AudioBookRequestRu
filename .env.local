# Local development overrides (loaded automatically by the app).
# Full documentation lives in .env.example. Prowlarr, the download client
# (aria2), direct sources (knigavuhe), and Audiobookshelf are configured in the
# Settings UI and stored in the config database, not here.
ABR_APP__CONFIG_DIR=config # Path to the config directory. Default: /config
ABR_APP__DEBUG=true # Default: false
ABR_APP__OPENAPI_ENABLED=true # Default: false
ABR_APP__LOG_LEVEL=DEBUG
ABR_APP__BASE_URL=