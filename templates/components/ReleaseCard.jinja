{#def
    popularity: ReleasePopularity,
    user: DetailedUser,
#}
{% set release = popularity.release %}

<div class="flex flex-col gap-1 rounded-md bg-base-200 p-3 h-full">
    <div class="flex items-start justify-between gap-2">
        {% if release.info_url %}
            <a class="text-sm font-bold text-primary line-clamp-3"
               title="{{ release.title }}"
               target="_blank"
               rel="noreferrer"
               href="{{ release.info_url }}">{{ release.title }}</a>
        {% else %}
            <span class="text-sm font-bold text-primary line-clamp-3"
                  title="{{ release.title }}">{{ release.title }}</span>
        {% endif %}
        <span class="badge badge-sm badge-ghost shrink-0">{{ release.indexer }}</span>
    </div>
    {% if release.authors %}
        <div class="text-xs font-semibold line-clamp-1"
             title="Authors: {{ release.authors | join(", ") }}">
            {{ release.authors | join(", ") }}
        </div>
    {% endif %}
    {% if release.narrators %}
        <div class="text-xs opacity-70 line-clamp-1"
             title="Narrator: {{ release.narrators | join(", ") }}">
            Narrator: {{ release.narrators | join(", ") }}
        </div>
    {% endif %}
    <div class="text-xs opacity-60">
        {{ popularity.request_count }} request{% if popularity.request_count != 1 %}s{% endif %} · {{ release.protocol }}
        {% if release.size %}· {{ release.size_MB }} MB{% endif %}
    </div>
    <div class="mt-auto pt-1">
        <a class="btn btn-xs btn-primary"
           href="{{ base_url }}/search?q={{ release.title | urlencode }}"
           title="Search for this book's releases">
            <icons.Search />
            Search
        </a>
    </div>
</div>
