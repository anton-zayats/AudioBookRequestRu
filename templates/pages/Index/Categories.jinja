{#def
    title: str,
    user: DetailedUser,
    categories: dict | None = None,
    lazy_url: str | None = None,
    description: str | None = None,
    auto_start_download: bool = False,
#}

{% if lazy_url %}
    <div class="w-full max-w-7xl mb-8"
         hx-get="{{ base_url }}{{ lazy_url }}"
         hx-trigger="load"
         hx-swap="outerHTML">
        <div class="flex justify-between items-center mb-4">
            <div>
                <h2 class="text-2xl font-bold">
                    {{ title }}
                </h2>
                <p class="text-sm opacity-70">
                    {{ description }}
                </p>
            </div>
        </div>
    </div>
{% else %}
    <div class="w-full max-w-7xl mb-8">
        <div class="flex justify-between items-center mb-4">
            <div>
                <h2 class="text-2xl font-bold">
                    {{ title }}
                </h2>
                <p class="text-sm opacity-70">
                    {{ description }}
                </p>
            </div>
        </div>
        {% for category, books in categories.items() %}
            <div class="mb-6">
                <h3 class="text-lg font-semibold mb-2 capitalize">
                    {{ category }}
                </h3>
                {% if books %}
                    <div class="flex gap-4 pb-4 overflow-x-auto" style="max-width: 100%">
                        {% for result in books[:12] %}
                            <div class="flex-none w-32 sm:w-40">
                                <BookCard book_with_requests={{ result }} auto_start_download={{ auto_start_download }} user={{ user }} />
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="p-6 bg-base-200 rounded-md text-center">
                        <p class="text-sm opacity-70">
                            No books available in this category yet.
                        </p>
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
{% endif %}