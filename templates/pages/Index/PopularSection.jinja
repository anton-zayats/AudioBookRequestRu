{#def
    title: str,
    user: DetailedUser,
    cards: list | None = None,
    description: str | None = None,
    empty: str | None = None,
    lazy_url: str | None = None,
#}

{% if lazy_url %}
    <div class="w-full max-w-7xl mb-8"
         hx-get="{{ base_url }}{{ lazy_url }}"
         hx-trigger="load"
         hx-swap="outerHTML">
        <div class="flex justify-between items-center mb-4">
            <div>
                <h2 class="text-2xl font-bold">
                    {{ title }}
                </h2>
                <p class="text-sm opacity-70">
                    {{ description }}
                </p>
            </div>
        </div>
    </div>
{% else %}
    <div class="w-full max-w-7xl mb-8">
        <div class="flex justify-between items-center mb-4">
            <div>
                <h2 class="text-2xl font-bold">
                    {{ title }}
                </h2>
                <p class="text-sm opacity-70">
                    {{ description }}
                </p>
            </div>
        </div>
        <div class="overflow-x-auto">
            <div class="w-full max-w-7xl mb-8">
                {% if cards %}
                    <div class="flex gap-4 pb-4" style="width: max-content">
                        {% for card in cards[:12] %}
                            <div class="flex-none w-40 sm:w-52">
                                <ReleaseCard popularity={{ card }} user={{ user }} />
                            </div>
                        {% endfor %}
                    </div>
                {% elif empty %}
                    <div class="p-6 bg-base-200 rounded-md text-center">
                        <p class="text-sm opacity-70">
                            {{ empty }}
                        </p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endif %}
