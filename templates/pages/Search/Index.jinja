{#def
    user: DetailedUser,
    search_term: str,
    search_results: list[ReleaseView],
    page: int,
    source: str = "both",
    has_more: bool = False,
#}

<BaseLayout title="Search" user={{ user }}>
<script>
    const onSearch = () => {
        document.getElementById("search").disabled = true;
        document.getElementById("search-text").style.display = "none";
        document.getElementById("search-spinner").style.display = "inline-block";
    };
    const onPageChange = page => {
        const url = new URL(window.location);
        url.searchParams.set("page", page);
        window.location = url;
    };
</script>
<div class="w-screen flex flex-col items-center justify-center p-6 sm:p-8 overflow-x-hidden gap-4">
    <div class="flex w-full justify-between items-center">
        <h1 class="text-3xl font-bold text-left">
            Search
        </h1>
        <a preload
           href="{{ base_url }}/search/manual"
           title="Manually add request"
           class="btn btn- flex items-center justify-center">
            Manual
            <icons.Plus />
        </a>
    </div>
    <div class="flex flex-col gap-4 justify-start items-center w-full">
        <form class="flex items-start w-full join"
              method="get"
              onsubmit="onSearch();">
            <input name="q"
                   class="input join-item focus:z-10"
                   placeholder="Book name..."
                   {% if not search_term %}autofocus{% endif %}
                   value="{{ search_term }}"
                   spellcheck="false"
                   autocomplete="off" />
            <select name="source"
                    class="select join-item w-36"
                    title="Where to search for releases"
                    onchange="this.form.submit()">
                <option value="both" {% if source != "tracker" and source != "direct" %}selected{% endif %}>
                    All sources
                </option>
                <option value="tracker" {% if source == "tracker" %}selected{% endif %}>
                    Trackers
                </option>
                <option value="direct" {% if source == "direct" %}selected{% endif %}>
                    Direct
                </option>
            </select>
            <button id="search" class="btn btn-primary join-item" type="submit">
                <span id="search-text">Search</span>
                <span id="search-spinner" class="loading hidden"></span>
            </button>
        </form>
        {% block book_results %}
            <div id="book-results" class="w-full overflow-x-auto">
                {% if search_results %}
                <table class="table table-zebra table-pin-rows min-w-200">
                    <thead>
                        <tr>
                            <th>
                                Title
                            </th>
                            <th>
                                Narrator
                            </th>
                            <th>
                                Source
                            </th>
                            <th>
                                Protocol
                            </th>
                            <th>
                                Seed / leech
                            </th>
                            <th>
                                Size (MB)
                            </th>
                            <th>
                                Status
                            </th>
                            <th>
                                Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for view in search_results %}
                            <Search.Row view={{ view }} />
                        {% endfor %}
                    </tbody>
                </table>
                {% endif %}
            </div>
        {% endblock book_results %}
        {% if search_results or page > 0 %}
            <div class="join">
                <button class="join-item btn"
                        title="Previous page"
                        onclick="onPageChange('{{ (page - 1) if page > 0 else 0 }}')"
                        {% if page == 0 %}disabled{% endif %}>
                    « Previous
                </button>
                <span class="join-item btn btn-active pointer-events-none">Page {{ page + 1 }}</span>
                <button class="join-item btn"
                        title="Next page"
                        onclick="onPageChange('{{ page + 1 }}')"
                        {% if not has_more %}disabled{% endif %}>
                    Next »
                </button>
            </div>
        {% endif %}
        {% if not search_results %}
            <div class="pt-8 flex flex-col gap-1 items-center justify-center text-center max-w-[20rem]">
                {% if search_term and page > 0 %}
                    <span class="text-xl font-semibold">No more results</span>
                    <span class="text-sm">This page is past the end of the result list.</span>
                {% elif search_term %}
                    <span class="text-xl font-semibold">No results found</span>
                    <span class="text-sm">No releases were found. Try a different title or
                        <a class="link" preload href="{{ base_url }}/search/manual">add a request manually</a>.</span>
                {% else %}
                    <span class="text-xl font-semibold">Perform a search</span>
                    <span class="text-sm opacity-60">Nothing has been searched yet.</span>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>
</BaseLayout>
