{#def
    view: ReleaseView,
#}
{% set release = view.release %}
{% set sample = "sample" in release.indexer_flags %}
{% set downloading = view.state == "sent" %}
{% set redownload = view.state == "completed" or view.state == "failed" %}
{% set no_files = release.protocol == "direct" and not release.download_urls %}
{% set redownload = view.state == "completed" or view.state == "failed" %}
<tr id="release-row-{{ release.id }}" class="text-xs lg:text-sm">
    <td>
        {% if release.info_url %}
            <a href="{{ release.info_url }}" class="link" target="_blank" rel="noreferrer">{{ release.title }}</a>
        {% else %}
            {{ release.title }}
        {% endif %}
        {% if release.authors %}
            <span class="opacity-60">— {{ release.authors | join(", ") }}</span>
        {% endif %}
    </td>
    <td>
        {{ release.narrators | join(", ") }}
    </td>
    <td>
        {{ release.indexer }}
    </td>
    <td>
        {{ release.protocol }}
    </td>
    <td>
        {% if release.protocol == "torrent" %}
            {{ release.seeders }} / {{ release.leechers }}
        {% elif release.protocol == "usenet" %}
            {{ release.grabs }} grabs
        {% else %}
            {{ release.download_urls | length }} file(s)
        {% endif %}
    </td>
    <td>
        {% if release.size %}{{ release.size_MB }}{% else %}—{% endif %}
    </td>
    <td>
        <div class="flex flex-col gap-1 items-start">
            {% if view.in_library or view.state != "not_downloaded" %}
                <span class="badge badge-sm {{ view.status_tone }}">{{ view.status_label }}</span>
            {% endif %}
            {% if sample %}
                <span class="badge badge-sm badge-warning">Sample</span>
            {% endif %}
            {% for flag in release.indexer_flags %}
                {% if flag != "sample" %}
                    <span class="badge badge-sm badge-ghost">{{ flag }}</span>
                {% endif %}
            {% endfor %}
        </div>
    </td>
    <td>
        <div class="flex flex-wrap gap-1">
            <button class="btn btn-sm btn-primary"
                    title="{% if no_files %}This release has no downloadable files{% elif sample %}Sample-only releases cannot be downloaded{% elif downloading %}Download in progress{% elif redownload %}Download this release again{% else %}Send this release to the download client{% endif %}"
                    hx-post="{{ base_url }}/search/hx-download/{{ release.id }}"
                    hx-target="closest tr"
                    hx-swap="outerHTML"
                    {% if no_files or sample or downloading %}disabled{% endif %}>
                <icons.Download />
                {% if downloading %}
                    Downloading
                {% elif redownload %}
                    Redownload
                {% else %}
                    Download
                {% endif %}
            </button>
            <button class="btn btn-sm {% if view.bookmarked %}btn-active{% endif %}"
                    title="{% if sample %}Sample-only releases cannot be requested{% elif view.bookmarked %}Remove this release from your requests{% else %}Download this release later{% endif %}"
                    hx-post="{{ base_url }}/search/hx-toggle-request/{{ release.id }}"
                    hx-target="closest tr"
                    hx-swap="outerHTML"
                    {% if sample %}disabled{% endif %}>
                {% if view.bookmarked %}
                    Remove from requests
                {% else %}
                    Add to requests
                {% endif %}
            </button>
        </div>
    </td>
</tr>
