{#def
    result: QueryResult,
#}

{% set book_id = result.book.id %}
{% set is_manual = result.book.publish_date is defined %}

<div class="w-screen p-2 md:p-4 lg:p-8 flex flex-col gap-2" id="sources">
    <a preload
       href="{{ base_url }}/wishlist{% if is_manual %}/manual{% endif %}#{{ book_id }}"
       class="w-fit btn btn-ghost">&lt; Back to wishlist</a>
    <h1 class="text-3xl font-bold">
        Sources for {{ result.book.title }}
    </h1>
    {% if result.ok and not result.sources %}
        <div role="alert" class="alert">
            <span class="stroke-info h-6 w-6 shrink-0">
                <icons.InfoCircle />
            </span>
            <span>No results found for "{{ result.book.title }}" by
                {{ result.book.authors|join(",") }}. Might have to be looked up
            manually.</span>
        </div>
        {% set parts = split_combined_title(result.book.title) %}
        {% if parts %}
            <div class="alert alert-info flex-col items-start gap-2">
                <span class="text-sm">This looks like a combined edition. Search each work separately:</span>
                <div class="flex flex-wrap gap-2">
                    {% for part in parts %}
                        <a class="btn btn-sm btn-outline"
                           href="{{ base_url }}/search?q={{ part }}{% if result.book.authors %} {{ result.book.authors|join(' ') }}{% endif %}">
                            {{ part }}
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    {% elif not result.ok %}
        <div role="alert"
             class="alert"
             hx-get="{{ base_url }}/wishlist/sources/{{ book_id }}?only_body=true"
             hx-trigger="load"
             hx-target="#sources"
             hx-swap="outerHTML">
            <span class="stroke-info h-6 w-6 shrink-0">
                <icons.InfoCircle />
            </span>
            <span>Fetching sources from prowlarr
                <span class="ml-2 loading loading-dots"></span>
            </span>
        </div>
    {% endif %}
    <div class="overflow-x-auto">
        <table class="table table-zebra table-pin-rows min-w-240">
            <thead>
                <tr>
                    <th>
                    </th>
                    <th>
                        title
                    </th>
                    <th>
                        author(s)
                    </th>
                    <th>
                        narrator(s)
                    </th>
                    <th>
                        indexer
                    </th>
                    <th>
                        flags
                    </th>
                    <th>
                        seed / leech (or grabs)
                    </th>
                    <th>
                        size (MB)
                    </th>
                    <th>
                        publish date
                    </th>
                    <th>
                    </th>
                </tr>
            </thead>
            <tbody>
                {% for source in (result.sources or []) %}
                    <tr class="text-xs lg:text-sm {% if loop.index==1 %}bg-success dark:text-gray-700{% endif %}">
                        <th>
                            {{ loop.index }}
                        </th>
                        <td>
                            {% if source.info_url %}
                                <a href="{{ source.info_url }}" class="link">{{ source.title }}</a>
                            {% else %}
                                {{ source.title }}
                            {% endif %}
                        </td>
                        <td>
                            {% if source.book_metadata.authors %}
                                {{ source.book_metadata.authors|join(", ") }}
                            {% endif %}
                        </td>
                        <td>
                            {% if source.book_metadata.narrators %}
                                {{ source.book_metadata.narrators|join(", ") }}
                            {% endif %}
                        </td>
                        <td>
                            {{ source.indexer }}
                        </td>
                        <td>
                            {{ source.indexer_flags|join(", ") }}
                        </td>
                        {% if source.protocol == "torrent" %}
                            <td>
                                {{ source.seeders }} / {{ source.leechers }}
                            </td>
                        {% elif source.protocol == "usenet" %}
                            <td>
                                {{ source.grabs }} grabs
                            </td>
                        {% else %}
                            <td>
                                {{ source.download_urls|length }} file(s)
                            </td>
                        {% endif %}
                        <td>
                            {{ source.size_MB }}
                        </td>
                        <td>
                            {{ source.publish_date.strftime("%d. %b %Y") }}
                        </td>
                        <td>
                            <label id="form-{{ loop.index }}"
                                   class="swap swap-flip"
                                   title="Send to download client">
                                <input id="checkbox-{{ loop.index }}"
                                       type="checkbox"
                                       hx-trigger="click"
                                       hx-target="this"
                                       hx-post="{{ base_url }}/wishlist/sources/{{ book_id }}"
                                       hx-include="#form-{{ loop.index }}"
                                       hx-on::after-request="if (event.detail.successful) this.disabled = true" />
                                <input type="hidden" name="indexer_id" value="{{ source.indexer_id }}" />
                                <input type="hidden" name="guid" value="{{ source.guid }}" />
                                {% if source.protocol == "direct" %}
                                    <input type="hidden" name="protocol" value="direct" />
                                    <input type="hidden" name="title" value="{{ source.title }}" />
                                    <input type="hidden" name="indexer" value="{{ source.indexer }}" />
                                    {% for url in source.download_urls %}
                                        <input type="hidden" name="download_urls" value="{{ url }}" />
                                    {% endfor %}
                                {% endif %}
                                <span class="swap-off">
                                    <icons.Download />
                                </span>
                                <span class="swap-on text-success">
                                    <icons.Checkmark />
                                </span>
                            </label>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
