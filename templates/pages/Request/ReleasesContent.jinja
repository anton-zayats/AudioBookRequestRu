{#def
    result: QueryResult,
    user: DetailedUser,
#}

{% set book = result.book %}

<div class="w-screen p-2 md:p-4 lg:p-8 flex flex-col gap-2" id="releases">
    <a preload
       href="{{ base_url }}/"
       class="w-fit btn btn-ghost">&lt; Back</a>
    <h1 class="text-3xl font-bold">
        Choose a release for {{ book.title }}
    </h1>
    {% if book.authors %}
        <div class="text-sm opacity-60">
            {{ book.authors | join(", ") }}
        </div>
    {% endif %}

    {% if not result.ok %}
        <div role="alert"
             class="alert"
             hx-get="{{ base_url }}/request/{{ book.id }}/releases?only_body=true"
             hx-trigger="load"
             hx-target="#releases"
             hx-swap="outerHTML">
            <span class="stroke-info h-6 w-6 shrink-0">
                <icons.InfoCircle />
            </span>
            <span>Fetching releases
                <span class="ml-2 loading loading-dots"></span>
            </span>
        </div>
    {% elif not result.sources %}
        <div role="alert" class="alert">
            <span class="stroke-info h-6 w-6 shrink-0">
                <icons.InfoCircle />
            </span>
            <span>No releases found for "{{ book.title }}".</span>
        </div>
    {% endif %}

    {% if result.ok %}
        <div class="flex items-center gap-2">
            <button class="btn"
                    hx-post="{{ base_url }}/request/hx-add/{{ book.id }}"
                    hx-target="#releases"
                    hx-swap="outerHTML"
                    hx-disabled-elt="this">
                <icons.Plus />
                Request without choosing a release
            </button>
        </div>
    {% endif %}

    {% if result.ok and result.sources %}
        <div class="overflow-x-auto">
            <table class="table table-zebra table-pin-rows min-w-240">
                <thead>
                    <tr>
                        <th>
                        </th>
                        <th>
                            title
                        </th>
                        <th>
                            narrator(s)
                        </th>
                        <th>
                            indexer
                        </th>
                        <th>
                            protocol
                        </th>
                        <th>
                            flags
                        </th>
                        <th>
                            seed / leech (or grabs)
                        </th>
                        <th>
                            size (MB)
                        </th>
                        <th>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% for source in result.sources %}
                        <tr class="text-xs lg:text-sm {% if loop.index==1 %}bg-success dark:text-gray-700{% endif %}">
                            <th>
                                {{ loop.index }}
                            </th>
                            <td>
                                {% if source.info_url %}
                                    <a href="{{ source.info_url }}" class="link">{{ source.title }}</a>
                                {% else %}
                                    {{ source.title }}
                                {% endif %}
                            </td>
                            <td>
                                {% if source.book_metadata.narrators %}
                                    {{ source.book_metadata.narrators | join(", ") }}
                                {% endif %}
                            </td>
                            <td>
                                {{ source.indexer }}
                            </td>
                            <td>
                                {{ source.protocol }}
                            </td>
                            <td>
                                {{ source.indexer_flags | join(", ") }}
                            </td>
                            {% if source.protocol == "torrent" %}
                                <td>
                                    {{ source.seeders }} / {{ source.leechers }}
                                </td>
                            {% elif source.protocol == "usenet" %}
                                <td>
                                    {{ source.grabs }} grabs
                                </td>
                            {% else %}
                                <td>
                                    {{ source.download_urls | length }} file(s)
                                </td>
                            {% endif %}
                            <td>
                                {{ source.size_MB }}
                            </td>
                            <td>
                                <form hx-post="{{ base_url }}/request/hx-select/{{ book.id }}"
                                      hx-swap="none"
                                      hx-disabled-elt="find button">
                                    <input type="hidden" name="protocol" value="{{ source.protocol }}" />
                                    <input type="hidden" name="guid" value="{{ source.guid }}" />
                                    <input type="hidden" name="title" value="{{ source.title }}" />
                                    <input type="hidden" name="narrators" value="{{ source.book_metadata.narrators | join(',') }}" />
                                    <button type="submit" class="btn btn-primary btn-sm">
                                        Request this release
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>