{#def
    user: DetailedUser,
    enabled: bool,
    knigavuhe_base_url: str,
    max_candidates: int,
#}

<SettingsLayout user={{ user }} page="sources" title="Settings - Direct sources">

<main class="flex flex-col gap-4">
    <h2 class="text-lg">
        Direct sources
    </h2>
    <p class="text-xs opacity-60">
        Configure direct (non-tracker) download sources. Currently supported:
        knigavuhe.org.
    </p>

    <Settings.DirectSources enabled={{ enabled }} knigavuhe_base_url={{ knigavuhe_base_url }} max_candidates={{ max_candidates }} />
</main>

</SettingsLayout>
